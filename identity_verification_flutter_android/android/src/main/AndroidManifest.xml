<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- H5 刷脸（放心签 faceIntegrate / 腾讯慧眼 H5）需要联网 + 相机 + 麦克风 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <!-- H5 刷脸 WebView 容器 Activity（对齐 uniapp DC-WBH5FaceVerifyService 的插件内 Activity） -->
        <!-- 主题用 H5FaceVerifyTheme：values（亮色）+ values-night（暗色）自动跟随系统暗夜 -->
        <activity
            android:name=".H5FaceVerifyActivity"
            android:exported="false"
            android:theme="@style/H5FaceVerifyTheme"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />
    </application>
</manifest>